# Fairwork Environment Configuration Template
# Duplicate this file as .env and fill in values for production/staging Supabase instance.
# DO NOT commit .env with real secrets to version control!

# Public Supabase API credentials (safe for client bundle)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Application Configuration
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173

# Server / Edge Function Secrets (NEVER expose to client bundle!)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres
# WEBHOOK_SECRET=your_simulated_or_real_webhook_hmac_secret
